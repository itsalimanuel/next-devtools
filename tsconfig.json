{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "jsx": "react-jsx",
    "declarationDir": "./dist",
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "include": ["next-env.d.ts", "**/*.ts", "core/**/*.tsx","components/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
